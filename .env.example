# AcoustID Web API key (free registration at https://acoustid.org/)
ACOUSTID_API_KEY=

# Spotify Developer API credentials (optional, for enriched metadata)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Discogs Personal Access Token (optional, generate at https://www.discogs.com/settings/developers)
DISCOGS_TOKEN=

# Songlink / Odesli API Key (optional, for authenticated cross-platform link resolution)
SONGLINK_API_KEY=

# MusicBrainz User-Agent header (required by MusicBrainz terms of use)
MUSICBRAINZ_USER_AGENT=

# Provider rate limit delay in seconds (default: 1.0s for MusicBrainz compliance)
RATE_LIMIT_DELAY=1.0

# Minimum cover art resolution in pixels (default: 600)
COVER_ART_MIN_RESOLUTION=600

# Minimum confidence score for auto-injecting tags (0.0 to 1.0, default: 0.70)
CONFIDENCE_THRESHOLD=0.70
